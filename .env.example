# Copy to .env and fill in. The CLI reads this file; real environment
# variables win over values in the file.

# GCP project that will hold the bucket and datasets (required)
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery / GCS location. Public boundary data lives in the US multi-region,
# so keep this US unless you copy that data yourself.
GCP_LOCATION=US

# Optional: override the derived bucket name (default: <project-id>-schools-raw)
# SCHOOLS_BUCKET=

# Optional: path to a terraform binary. If unset the CLI uses the terraform
# on PATH, and falls back to the hashicorp/terraform Docker image.
# TERRAFORM_BIN=

# Optional: path to the ADC json that the Docker fallback mounts read-only.
# GOOGLE_APPLICATION_CREDENTIALS=
